# Active preset from `model_presets/` — selects the backend, and the model on Ollama
PRESET=anthropic

# Docker image built by `build.sh` and run by `claude-in-a-box`
IMAGE_NAME=claude-in-a-box

# Anthropic backend: path to the token file — never the token, this file is committed
CLAUDE_TOKEN_FILE=$HOME/.config/claude-in-a-box/claude_code_token

# Ollama backend: endpoint + placeholder token (not a secret)
OLLAMA_URL=http://localhost:11434
OLLAMA_AUTH_TOKEN=ollama
